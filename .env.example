# Environment variables required to run StudioOS locally.
# If you clone this project, copy this file to .env.local using: Copy-Item .env.example .env.local
# Then add your own credentials and API keys.
# Never commit .env.local or expose your secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=

# Authentication
AUTH_SECRET=

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT_ID=
GEMINI_API_KEY=

# Parallel
PARALLEL_API_KEY=

PADDLE_API_KEY=pdl_..
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
PADDLE_WEBHOOK_SECRET=pdl_...
PADDLE_PRO_MONTHLY_PRICE_ID=pri_...
PADDLE_PRO_YEARLY_PRICE_ID=pri_...
PADDLE_ENTERPRISE_MONTHLY_PRICE_ID=pri_...
PADDLE_ENTERPRISE_YEARLY_PRICE_ID=pri_...

# Paystack
PAYSTACK_SECRET_KEY=sk_..
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_...
PAYSTACK_WEBHOOK_SECRET=