# Environment variables required to run StudioOS locally.
# If you clone this project, copy this file to .env.local using: Copy-Item .env.example .env.local
# Then add your own credentials and API keys.
# Never commit .env.local or expose your secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=
MONGODB_DB=

# Authentication
AUTH_SECRET=

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT_ID=
GEMINI_API_KEY=

# Parallel
PARALLEL_API_KEY=